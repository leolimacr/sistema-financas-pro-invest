{
  "rules": {
    "transactions": {
      "$uid": {
        ".indexOn": ["date", "sortKey"],
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "newsletter": {
      "subscribers": {
        ".read": "false",
        ".write": "auth != null"
      }
    }
  }
}
