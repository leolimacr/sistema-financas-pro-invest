# Firebase Configuration (obrigatório)
VITE_FIREBASE_API_KEY=sua_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu_projeto.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://seu_projeto-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=seu_projeto
VITE_FIREBASE_STORAGE_BUCKET=seu_projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:android:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# App Check — reCAPTCHA v3 Site Key (obrigatório em produção)
# Crie uma chave em https://console.cloud.google.com/apis/credentials (tipo: "Site key" para reCAPTCHA v3)
# VITE_FIREBASE_APP_CHECK_SITE_KEY=6LcXXXXXXXXXX

# App Check — Debug Token (apenas desenvolvimento local)
# 1. Execute FIREBASE_APPCHECK_DEBUG_TOKEN=true no console do navegador
# 2. Recarregue a página
# 3. Copie o token exibido no console
# 4. Registre em Firebase Console > App Check > Gerenciar tokens de depuração
# 5. Opcional: coloque o token aqui para persistir entre sessões
# VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=seu_debug_token_aqui
